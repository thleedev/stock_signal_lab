# 웹앱 주소 — 수집기는 Supabase 에 직접 붙지 않고 이 서버를 거칩니다.
# 에뮬레이터에서 로컬 테스트: http://10.0.2.2:3000
# 실제 기기에서 로컬 테스트: http://192.168.0.7:3000 (같은 WiFi)
WEBAPP_URL=https://your-app.vercel.app

# web/.env.local 의 COLLECTOR_API_KEY 와 같은 값
# X-Device-Key 헤더로 보내고 서버가 verifyCollectorKey 로 검사합니다.
COLLECTOR_API_KEY=your-collector-api-key

# 기기 식별자
DEVICE_ID=collector-001
